# 복사해서 .env 로 만들고 값 채우기
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173
VIDEO_DIR=data/videos
OUTPUT_DIR=outputs

# 프론트(Vite)에서 읽는 값은 VITE_ 접두사가 필요하다. 실제 사용은 front/.env 에 둔다
VITE_API_URL=http://localhost:8000

# CVAT (라벨링 도구). 실제 값은 팀 채팅에서
CVAT_URL=https://app.cvat.ai
CVAT_USER=
CVAT_PASSWORD=

# PostgreSQL 접속 주소 (아찔한 순간 기록). 비밀번호만 바꾼다. DB를 안 쓰면 비워 둬도 된다
DATABASE_URL=postgresql+psycopg://postgres:비밀번호@localhost:5432/teum